  grid(columns: (1fr, 1fr), column-gutter: 6pt,
    sub("lidar_on_camera.png", [(a) 激光雷达点，颜色表示深度]),
    sub("radar_on_camera.png", [(b) 毫米波雷达点（黄色）]),
  ),
