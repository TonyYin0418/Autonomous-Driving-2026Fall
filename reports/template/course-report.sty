\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{course-report}[2026/09/22 Reusable Chinese course report style]

\RequirePackage[a4paper,margin=2.5cm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage{setspace}
\RequirePackage{indentfirst}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{graphicx}
\RequirePackage{subcaption}
\RequirePackage{placeins}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{amsmath,amssymb}
\RequirePackage{caption}
\RequirePackage{xcolor}
\RequirePackage[outputdir=build]{minted}
\RequirePackage{hyperref}
\RequirePackage{url}

% Prefer the requested system fonts on WSL, with portable TeX fallbacks.
\IfFileExists{/mnt/c/Windows/Fonts/times.ttf}{
  \setmainfont[
    Path=/mnt/c/Windows/Fonts/,
    BoldFont=timesbd.ttf,
    ItalicFont=timesi.ttf,
    BoldItalicFont=timesbi.ttf
  ]{times.ttf}
}{\setmainfont{TeX Gyre Termes}}
\IfFileExists{/mnt/c/Windows/Fonts/simsun.ttc}{
  \setCJKmainfont[
    Path=/mnt/c/Windows/Fonts/,
    BoldFont=simhei.ttf
  ]{simsun.ttc}
  \setCJKsansfont[Path=/mnt/c/Windows/Fonts/,BoldFont=simhei.ttf]{simhei.ttf}
}{
  \setCJKmainfont{FandolSong}
  \setCJKsansfont{FandolHei}
}
\setmonofont{Latin Modern Mono}

\definecolor{ReportGray}{gray}{0.96}
\definecolor{RuleGray}{gray}{0.35}
\hypersetup{
  colorlinks=false,
  pdfborder={0 0 0},
  bookmarksnumbered=true,
  unicode=true
}

\setstretch{1.3}
\setlength{\parindent}{2em}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{3em}
\setlength{\headheight}{15pt}
\setcounter{tocdepth}{2}
\setcounter{secnumdepth}{3}

\titleformat{\section}{\large\bfseries\sffamily}{\thesection}{0.8em}{}
\titleformat{\subsection}{\normalsize\bfseries\sffamily}{\thesubsection}{0.8em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{\thesubsubsection}{0.8em}{}
\titlespacing*{\section}{0pt}{1.8ex plus .5ex}{1.0ex}
\titlespacing*{\subsection}{0pt}{1.5ex plus .4ex}{0.8ex}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\CourseName}
\fancyhead[R]{\small\StudentName\,·\,\StudentID}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}

\captionsetup{font=small,labelfont=bf,labelsep=quad}
\renewcommand{\thefigure}{\thesection-\arabic{figure}}
\renewcommand{\thetable}{\thesection-\arabic{table}}
\numberwithin{equation}{section}

\setminted{
  bgcolor=ReportGray,
  fontsize=\small,
  breaklines=true,
  linenos=true,
  numbersep=8pt,
  frame=lines,
  framesep=3mm,
  rulecolor=\color{RuleGray},
  tabsize=4
}

\newcommand{\makecoursecover}{
  \begin{titlepage}
    \thispagestyle{empty}
    \centering
    \vspace*{1.5cm}
    {\LARGE\bfseries\sffamily \UniversityName\par}
    \vspace{2.8cm}
    {\Huge\bfseries\sffamily \ReportTitle\par}
    \vspace{0.8cm}
    {\Large\sffamily \ReportSubtitle\par}
    \vfill
    \renewcommand{\arraystretch}{1.55}
    \begin{tabular}{@{}rl@{}}
      学院： & \CollegeName \\
      专业： & \MajorName \\
      课程： & \CourseName \\
      姓名： & \StudentName \\
      学号： & \StudentID \\
      指导教师： & \InstructorName \\
      完成日期： & \CompletionDate \\
    \end{tabular}
    \vspace{2.2cm}
  \end{titlepage}
  \clearpage
  \pagenumbering{arabic}
  \setcounter{page}{1}
}
